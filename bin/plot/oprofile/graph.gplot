set terminal epscairo enhanced color font 'Arial,18' background rgb 'white' size 5in, 3.5in
set datafile missing '?'

set style fill solid 1 border lt -1
set border front

load palette_file

set output output_file

unset key

set yrange [0:*]
set xrange [minx:maxx]

set title title_tag noenhanced

set xlabel "Cluster size (#nodes)"
set ylabel label_y noenhanced

bs = box_size + 0 

unset xtics 
set grid noxtics front

set xtics nomirror format " " offset bs/2

do for [ii=1:words(label_xtics)] { set xtics add ( word(label_xtics,ii) ii-1 ) }

plot for [col=1:cols] input_file \
	u ($0-1-(bs*cols)/2+bs*col-bs/2):(column(col*3-1)):(bs) w boxes ls col fillstyle pattern col, \
	for [col=1:cols] '' u ($0-1-(bs*cols)/2+bs*col-bs/2):(column(col*3-1)):(column(col*3)):(column(col*3+1)) w yerrorbars notitle lw 2 lc 0 ps 0
