set terminal epscairo enhanced color font 'Arial,18' background rgb 'white' size 5in, 3.5in

set style fill solid 1 border lt -1

load palette_file
bs = 0.15

set noborder
set noxtics
set noytics
set noxlabel
set noylabel
set xrange [-10:10]
set yrange [-10:-9] 

set title "Legend" noenhanced

set key horiz center top

set output legend_file

plot for [col=1:cols] input_file \
	u col:(bs) w boxes ls col fillstyle pattern col title columnheader(col)
