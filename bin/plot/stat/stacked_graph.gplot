set terminal epscairo enhanced color font 'Arial,18' background rgb 'white' size 5in, 3.5in
set datafile missing '-'
set datafile separator ","

load palette_file

set output output_file

set xdata time
set timefmt "%s"

set style data boxes 
set style fill solid 1.0 noborder
set boxwidth 1.1 relative

set border front
set grid

set key outside horiz center top
set key autotitle columnheader noenhanced

set yrange [0:*]
set xrange ["0":max_x]

set xlabel "Time (min:sec)"

if (exists("format_y")) {
    if (format_y eq 'bytes') {
        set format y "%.0s %cB"
        set yrange [0 : 1024 < *]
    } else if (format_y eq 'percent') {
        set yrange [0:105]
    }
}

if (exists("label_y")) set ylabel label_y noenhanced

if (exists("max_y")) set yrange [0:max_y]

set xtics tic_interval

col_sum(col) = ((col == 1) ? 0 : col_sum(col-1) + column(col))

plot for [col=(cols+1):2:-1] input_file \
	using 1:(col_sum(col)) ls col lw -1 title columnheader(col)
