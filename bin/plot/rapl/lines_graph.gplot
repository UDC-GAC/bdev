set terminal epscairo enhanced color font 'Arial,18' background rgb 'white' size 5in, 3.5in
set datafile missing '-'
set datafile separator ","

load palette_file

set output output_file

set xdata time
set timefmt "%s"
set style data linespoints

set border front
set grid

set key outside horiz center top
set key autotitle columnheader noenhanced

set yrange [0:*]
set xrange ["0":max_x]

set xlabel "Time (min:sec)"

if (exists("format_y")) {
    if (format_y eq 'bytes') {
        set format y "%.0s %cB"
        set yrange [0 : 1024 < *]
    }
    if (format_y eq 'percent') {
        set yrange [0:105]
    }
}

if (exists("label_y")) set ylabel label_y noenhanced

if (exists("max_y")) set yrange [0:max_y]

set xtics tic_interval

ncol = 0

plot for [i=1:words(input_files)] for [col=2:(word(cols,i)+1)] word(input_files,i) \
	using 1:col ls (ncol=ncol+1) lw 2
